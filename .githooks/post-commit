#!/usr/bin/env bash
set -euo pipefail
[ "$(git branch --show-current)" = main ] || exit 0

exec 9>"$(git rev-parse --git-common-dir)/auto-push.lock"
flock -w 300 9
commit="$(git rev-parse HEAD)"
result=0
timeout 45s env GIT_TERMINAL_PROMPT=0 git push origin "$commit":main || {
  printf '推送失败；保留本地提交，继续更新本机技能。\n' >&2
  result=1
}

snapshot="$(mktemp -d)"
trap 'rm -rf -- "$snapshot"' EXIT
git archive "$commit" skills | tar -x -C "$snapshot"
exec 8>/tmp/personal-agent-skills-install.lock
flock -w 180 8
if ! timeout 120s env DISABLE_TELEMETRY=1 npx --yes skills@1.5.22 add "$snapshot" \
  --skill '*' --global --agent codex --copy --yes >"$snapshot/install.log" 2>&1; then
  cat "$snapshot/install.log" >&2
  exit 1
fi
for source in "$snapshot"/skills/*; do
  [ -f "$source/SKILL.md" ] || continue
  diff -qr "$source" "$HOME/.agents/skills/$(basename "$source")" || exit 1
done
printf '本机技能已更新并核验。\n'
exit "$result"
